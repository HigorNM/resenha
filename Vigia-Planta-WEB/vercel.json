{
    "functions": {
        "*.php": {
            "runtime": "vercel-php@0.7.4"
        }
    },
    "routes": [
        {
            "src": "/(CSS|images)/(.*)",
            "dest": "/$1/$2"

        },
        {
            "src": "/(.*)",
            "dest": "/index.php"
        }
    ]
}